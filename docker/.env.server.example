# Server env: copy to $DEPLOYMENT_FOLDER/.env on the server during the first deploy and
# fill it in. Read only by docker compose (--env-file); CI never edits anything in it
# except the IMAGE_TAG line. The ordered bootstrap checklist is in FORK.md, "Первый запуск".
#
# It belongs one level ABOVE docker/ — CI rsyncs docker/ on every deploy and would
# overwrite a file placed inside it.

# Host port the ispmanager panel reverse-proxies google-ads-mcp.qmedia.by to.
# Must be unique on the server — pick a free one when several projects share it.
PORT_MCP=16800

# Rewritten by CI on every deploy; `latest` is only the seed value for the first one.
IMAGE_TAG=latest

REDIS_PASSWORD=CHANGE_ME                  # openssl rand -hex 16

# Agency developer token. Needs the "Researching keywords and recommendations"
# permissible use, otherwise planning_generate_keyword_ideas is blocked.
GOOGLE_ADS_DEVELOPER_TOKEN=CHANGE_ME
# The MCC the server reaches client Accounts through.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=CHANGE_ME

# The Account Registry: the agency's Google Sheet mapping each Client to their
# Accounts. It is also this deployment's allowlist — an Account the Registry does
# not list cannot be queried — so connecting a Client is one edit in the Sheet and
# nothing here. See FORK.md, "Реестр Аккаунтов".
#
# Both lines below must be present AND non-empty; the deploy preflight refuses
# otherwise. An empty sheet id would read as "no Registry configured", which is
# upstream's unrestricted behaviour — fine for a laptop, not for this server, and
# never something a typo should be able to switch on.

# The id between /d/ and /edit in the Sheet's URL.
GOOGLE_ADS_REGISTRY_SHEET_ID=CHANGE_ME
# Service account JSON key, base64-encoded whole: `base64 -w0 key.json`.
# That service account needs the Sheet shared with it as a viewer, and the Google
# Sheets API enabled in its project. It is a robot, not a shared human login: to
# revoke this server's access, remove it from the file's sharing.
GOOGLE_ADS_REGISTRY_SA_KEY=CHANGE_ME
# Which tabs of the file are the Registry, comma-separated, named exactly as the
# tabs are named. Quote the value: tab names contain spaces.
#
# Leave it unset and only the *first* tab is read, which on the agency's file
# means most Clients are invisible and their Accounts are refused. It is an
# allowlist rather than a denylist on purpose — the file also has a tab of
# Clients who have left, and reading that one would put their Accounts back into
# the allowlist. A tab of the file missing from this list is reported as a
# problem on every read, so nothing is lost silently either way.
GOOGLE_ADS_REGISTRY_TABS='CHANGE_ME'
# Optional. The cell range read *within each tab*; defaults to A1:Z2000.
#GOOGLE_ADS_REGISTRY_RANGE=

# OAuth client, type Web application. Its Authorized redirect URI must be
# GOOGLE_ADS_MCP_BASE_URL + /auth/callback.
GOOGLE_ADS_MCP_OAUTH_CLIENT_ID=CHANGE_ME
GOOGLE_ADS_MCP_OAUTH_CLIENT_SECRET=CHANGE_ME
GOOGLE_ADS_MCP_BASE_URL=https://google-ads-mcp.qmedia.by

# FastMCP would derive a stable key from the client secret on its own; setting it here
# decouples token lifetime from that secret, so rotating the secret in GCP does not log
# every Manager out. Rotating THIS key does. See FORK.md.
GOOGLE_ADS_MCP_JWT_SIGNING_KEY=CHANGE_ME  # openssl rand -hex 32
